# Banco instalado no servidor, fora do Docker: use host.docker.internal.
# Em homologação, o nome do banco termina em _hml: o deploy.sh confere antes de migrar.
DATABASE_URL="postgresql://USUARIO:SENHA@host.docker.internal:5432/BANCO"
DIRECT_URL="postgresql://USUARIO:SENHA@host.docker.internal:5432/BANCO"

NODE_ENV=production

# URL pública do ambiente: autenticação e links de e-mail dependem dela
NEXTAUTH_URL="https://app.exemplo.gov.br"
# Gerado pelo setup-host.sh com --segredos "AUTH_SECRET"
AUTH_SECRET=
# Atrás do Nginx: o Auth.js confia no Host repassado
AUTH_TRUST_HOST=true

# Dono das pastas montadas como volume no servidor: o setup-host.sh grava id -u e id -g
APP_UID=1000
APP_GID=1000
